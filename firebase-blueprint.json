{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and balance information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User profile photo URL" },
        "balance": { "type": "number", "description": "Current wallet balance" },
        "createdAt": { "type": "object", "description": "Timestamp of account creation" }
      },
      "required": ["uid", "email", "balance", "createdAt"]
    },
    "Watchlist": {
      "title": "Watchlist",
      "description": "User's stock watchlist",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner's user ID" },
        "symbols": { "type": "array", "items": { "type": "string" }, "description": "List of stock symbols" }
      },
      "required": ["uid", "symbols"]
    },
    "PortfolioItem": {
      "title": "PortfolioItem",
      "description": "A stock holding in the user's portfolio",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner's user ID" },
        "symbol": { "type": "string", "description": "Stock symbol" },
        "quantity": { "type": "number", "description": "Number of shares owned" },
        "averagePrice": { "type": "number", "description": "Average purchase price" },
        "lastUpdated": { "type": "object", "description": "Timestamp of last update" }
      },
      "required": ["uid", "symbol", "quantity", "averagePrice", "lastUpdated"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A record of a buy or sell transaction",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User ID who performed the transaction" },
        "symbol": { "type": "string", "description": "Stock symbol" },
        "type": { "type": "string", "enum": ["BUY", "SELL"], "description": "Transaction type" },
        "quantity": { "type": "number", "description": "Number of shares" },
        "price": { "type": "number", "description": "Price per share at time of transaction" },
        "timestamp": { "type": "object", "description": "Timestamp of transaction" }
      },
      "required": ["uid", "symbol", "type", "quantity", "price", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/watchlists/{userId}": {
      "schema": "Watchlist",
      "description": "User watchlist documents"
    },
    "/portfolios/{portfolioId}": {
      "schema": "PortfolioItem",
      "description": "Portfolio holdings"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Transaction history"
    }
  }
}
